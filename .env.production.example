# Copy this to .env on the server

# Home Assistant (must be reachable from the server)
HA_URL=http://192.168.1.77:8123
HA_TOKEN=your-long-lived-token-here

# Session encryption secret (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-string

# Access window (UTC timestamps)
# Saturday 10:30 CEST = 08:30 UTC
ACCESS_START=2026-05-16T08:30:00Z
# Sunday 18:00 CEST = 16:00 UTC
ACCESS_END=2026-05-18T16:00:00Z

# App name
NEXT_PUBLIC_APP_NAME=El Casito
